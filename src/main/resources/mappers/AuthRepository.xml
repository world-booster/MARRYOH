<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.grape.module.auth.repository.IAuthRepository">

    <insert id="insertToken" parameterType="com.grape.module.auth.model.AuthDto">
        INSERT INTO TB_TOKEN_SEC (
            TOKEN_KEY,
            USER_KEY,
            TOKEN,
            TOKEN_START_DT,
            TOKEN_END_DT
        ) VALUES (
            #{tokenKey},
            #{userKey},
            #{token},
            current_timestamp(),
            DATE_ADD(current_timestamp(), INTERVAL 3 YEAR)
        )
    </insert>

    <select id="existUserToken" parameterType="String" resultType="int">
        SELECT EXISTS (SELECT 1 FROM TB_TOKEN_SEC WHERE USER_KEY = #{userKey})
    </select>

    <delete id="deleteToken" parameterType="String">
        DELETE FROM TB_TOKEN_SEC WHERE USER_KEY = #{userKey}
    </delete>

    <delete id="deleteTokenByToken" parameterType="String">
        DELETE FROM TB_TOKEN_SEC WHERE TOKEN = #{token}
    </delete>

    <select id="selectRefreshToken" parameterType="String" resultType="String">
        SELECT TOKEN FROM TB_TOKEN_SEC WHERE USER_KEY = #{userKey}
    </select>

    <select id="selectUserKeyByToken" parameterType="String" resultType="String">
        SELECT USER_KEY FROM TB_TOKEN_SEC WHERE TOKEN = #{token}
    </select>
</mapper>